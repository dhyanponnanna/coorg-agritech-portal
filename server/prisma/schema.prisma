generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OWNER
  WORKER
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile?
  laborJobs     LaborJob[]
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  weatherSnapshots WeatherSnapshot[] @relation("LocationWeatherSnapshots")
  weatherAlerts    WeatherAlert[]
  emailSubscriptions EmailSubscription[]
}

model WeatherSnapshot {
  id                  String   @id @default(cuid())
  locationId          String?
  location            String
  latitude            Float
  longitude           Float
  temperature         Float?
  humidity            Float?
  apparentTemperature Float?
  precipitation       Float?
  rain                Float?
  weatherCode         Int?
  windSpeed           Float?
  windDirection       Float?
  recordedAt          DateTime @default(now())

  locationRef Location? @relation("LocationWeatherSnapshots", fields: [locationId], references: [id])

  @@index([locationId, recordedAt])
}

model WorkerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  phone        String?
  location     String?
  skills       String[]
  experience   Int?
  availability Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  applications LaborApplication[]
  invitations  LaborInvitation[]
}

model LaborJob {
  id              String    @id @default(cuid())
  ownerId         String
  title           String
  estateName      String
  location        String
  crop            String
  workType        String
  workersRequired Int
  requiredSkills  String[]
  startDate       DateTime
  endDate         DateTime
  wagePerDay      Float
  description     String?
  status          JobStatus @default(OPEN)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner        User               @relation(fields: [ownerId], references: [id])
  applications LaborApplication[]
  invitations  LaborInvitation[]

  @@index([ownerId])
  @@index([location])
  @@index([status])
}

model LaborApplication {
  id        String            @id @default(cuid())
  jobId     String
  workerId  String
  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  job    LaborJob      @relation(fields: [jobId], references: [id])
  worker WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model LaborInvitation {
  id        String           @id @default(cuid())
  jobId     String
  workerId  String
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  job    LaborJob      @relation(fields: [jobId], references: [id])
  worker WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model WeatherAlert {
  id          String        @id @default(cuid())
  locationId  String
  title       String
  message     String
  severity    AlertSeverity
  weatherCode Int?
  temperature Float?
  windSpeed   Float?
  createdAt   DateTime      @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([createdAt])
}
 
enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model EmailSubscription {
  id                String   @id @default(cuid())
  email             String   @unique
  isVerified        Boolean  @default(false)
  isActive          Boolean  @default(true)

  verificationToken String?  @unique
  unsubscribeToken  String   @unique

  tokenExpiresAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  
  receiveHighTemperature Boolean @default(true)
  receiveLowTemperature  Boolean @default(true)
  receiveHeavyRain       Boolean @default(true)
  receiveStrongWind      Boolean @default(true)

  locations         Location[]

  @@index([isVerified, isActive])
}