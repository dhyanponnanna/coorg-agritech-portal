generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OWNER
  WORKER
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeatherSnapshot {
  id                  String   @id @default(cuid())
  location            String
  latitude            Float
  longitude           Float
  temperature         Float?
  humidity            Float?
  apparentTemperature  Float?
  precipitation       Float?
  rain                Float?
  weatherCode         Int?
  windSpeed           Float?
  windDirection       Float?
  recordedAt          DateTime @default(now())

  @@index([location, recordedAt])
}